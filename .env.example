# TeamForge API Keys - Copy to .env.local and fill in your keys

# Anthropic (REQUIRED - used for all agent execution via Messages API)
ANTHROPIC_API_KEY=sk-ant-...

# Model configuration (optional - defaults shown)
# DEFAULT_MODEL is used by agents for execution
# FAST_MODEL is used for reviews, scouts, and context optimization
# EXPERT_MODEL is used for complex planning and coordination
DEFAULT_MODEL=claude-sonnet-4-20250514
FAST_MODEL=claude-3-5-haiku-20241022
EXPERT_MODEL=claude-opus-4-20250514

# Memawi memory server (REQUIRED for agent memory & context)
MEMAWI_URL=http://localhost:8765

# OpenAI (optional - for model listing in agent editor)
OPENAI_API_KEY=sk-...

# xAI / Grok (optional - for model listing)
XAI_API_KEY=xai-...

# Google Gemini (optional - for model listing)
GOOGLE_API_KEY=...

# Postgres (REQUIRED for persistent storage)
# Supports JDBC format: jdbc:postgresql://user:password@host:port/database
# Or standard format: postgresql://user:password@host:port/database
POSTGRES_DB_URL=jdbc:postgresql://user:password@localhost:5432/team_ai

# Next.js (optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000