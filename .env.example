# TeamForge API Keys - Copy to .env.local and fill in your keys
# xAI / Grok (recommended for Coordinator)
XAI_API_KEY=xai-...

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
GOOGLE_API_KEY=...

# Optional: for real tools
TAVILY_API_KEY=...
REPLICATE_API_TOKEN=...
E2B_API_KEY=...

# Next.js (optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000
