# TeamForge API Keys - Copy to .env.local and fill in your keys

# Anthropic (REQUIRED - used for all agent execution via Messages API)
ANTHROPIC_API_KEY=sk-ant-...

# Anthropic proxy overrides — when set, these take priority over DEFAULT/FAST/EXPERT_MODEL
# Use these to point at a cheaper provider that speaks the Anthropic Messages API format
# ANTHROPIC_BASE_URL=           # Proxy base URL (e.g. https://openrouter.ai/api/v1)
# ANTHROPIC_AUTH_TOKEN=         # Auth token (alternative to ANTHROPIC_API_KEY)
# ANTHROPIC_MODEL=              # Overrides DEFAULT_MODEL
# ANTHROPIC_DEFAULT_SONNET_MODEL=  # Overrides FAST_MODEL
# ANTHROPIC_DEFAULT_OPUS_MODEL=    # Overrides EXPERT_MODEL

# Model configuration (fallbacks when Anthropic-specific vars are not set)
# DEFAULT_MODEL is used by agents for execution
# FAST_MODEL is used for reviews, scouts, and context optimization
# EXPERT_MODEL is used for complex planning and coordination
DEFAULT_MODEL=claude-sonnet-4-20250514
FAST_MODEL=claude-3-5-haiku-20241022
EXPERT_MODEL=claude-opus-4-20250514

# Memawi memory server (REQUIRED for agent memory & context)
MEMAWI_URL=http://localhost:8765

# Memawi context consolidation: when true, use Memawi's API for extraction/consolidation.
# When false (default), use the local FAST_MODEL for context optimization.
MEMAWI_EXTRACT_CONSOLID=false

# OpenAI (optional - for model listing in agent editor)
OPENAI_API_KEY=sk-...

# xAI / Grok (optional - for model listing)
XAI_API_KEY=xai-...

# Google Gemini (optional - for model listing)
GOOGLE_API_KEY=...

# Postgres (REQUIRED for persistent storage)
# Supports JDBC format: jdbc:postgresql://user:password@host:port/database
# Or standard format: postgresql://user:password@host:port/database
POSTGRES_DB_URL=jdbc:postgresql://user:password@localhost:5432/team_ai

# Encryption key for API keys stored in database (change in production!)
ENCRYPTION_KEY=teamforge-default-encryption-key-change-in-prod

# Next.js (optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000